# Preencha com as credenciais reais do seu projeto Supabase (supabase.com)
# ou com os valores impressos por `supabase start` para desenvolvimento local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stable production URL, used for links inside outbound email and the password-reset
# redirect. Leave unset in preview/local — falls back to VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=

# SMTP relay (Brevo) — transactional email (reservation approved/cancelled, new tasks,
# password reset). "Fazer login" no painel Brevo (Campanhas > SMTP & API > SMTP) e o
# remetente precisam vir de lá; um remetente não verificado é bloqueado pela Brevo.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Fleet

# Approved normal operation: keep automatic release active; false is emergency suspension only.
FM_ENABLE_AUTO_RESERVATION_RELEASE=true

# Aprovação de reservas pelo WhatsApp (via n8n). Servidor apenas. Enquanto as duas estiverem vazias o envio fica DESLIGADO
# (nada muda no sistema). O segredo é o mesmo configurado no n8n (assinatura HMAC-SHA256 nos dois sentidos).
N8N_APPROVAL_WEBHOOK_URL=
N8N_APPROVAL_SECRET=
