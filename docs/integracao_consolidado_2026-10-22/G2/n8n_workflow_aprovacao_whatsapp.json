    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Procura, no evento do Evolution Go, o toque num botao do FleetMind (approve:<token> / reject:<token>), o telefone de quem tocou e o id da mensagem.\n// ATENCAO: o evento de um toque traz tambem a mensagem ORIGINAL citada, que lista os DOIS botoes. Por isso so vale um id que seja o valor inteiro\n// de um campo FORA da mensagem citada. Se sobrar mais de um id diferente (dois botoes), nao adivinha: ignora (o gestor aprova pelo sistema).\nconst cfg = $('Config entrada').first().json;\nconst evt = $('Mensagem recebida (Evolution)').first().json;\nconst body = evt.body ?? evt;\nconst info = (body.data && (body.data.Info || body.data.info)) || body.Info || {};\nconst fromMe = info.IsFromMe === true || info.isFromMe === true;\nif (fromMe) return [];\nconst QUOTED = new Set(['quotedMessage', 'QuotedMessage', 'contextInfo', 'ContextInfo']);\nconst ID = /^(approve|reject):[0-9a-f]{32,128}$/;\nconst found = new Set();\nconst walk = (v) => {\n  if (typeof v === 'string') { if (ID.test(v)) found.add(v); return; }\n  if (Array.isArray(v)) { v.forEach(walk); return; }\n  if (v && typeof v === 'object') for (const [k, x] of Object.entries(v)) { if (!QUOTED.has(k)) walk(x); }\n};\nwalk(body);\nif (found.size !== 1) return [];\nconst buttonId = [...found][0];\nconst text = JSON.stringify(body);\nconst phones = [...text.matchAll(/(\\d{10,15})@s\\.whatsapp\\.net/g)].map(x => x[1]).filter(p => p !== cfg.ownNumber);\nif (!phones.length) return [];\nconst messageId = String(info.ID || info.Id || info.id || '').slice(0, 200) || null;\nreturn [{ json: { button_id: buttonId, from: phones[0], message_id: messageId } }];"
      },
