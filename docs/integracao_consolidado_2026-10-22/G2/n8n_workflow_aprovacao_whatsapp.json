    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Monta o JSON que o FleetMind espera (a assinatura e calculada no no seguinte).\nconst meta = $('Classificar mensagem').first().json;\nconst out = { from: meta.from, message_id: meta.message_id, kind: meta.kind };\nif (meta.kind === 'text') out.text = meta.text;\nif (meta.kind === 'button') out.button_id = meta.button_id;\nif (meta.kind === 'audio') {\n  // a resposta do download traz o audio em base64; procura a maior string para nao depender do formato exato\n  let best = '';\n  const walk = (v) => { if (typeof v === 'string') { if (v.length > best.length) best = v; } else if (v && typeof v === 'object') Object.values(v).forEach(walk); };\n  walk($input.first().json);\n  if (best.length < 200) { out.kind = 'other'; } else { out.audio_base64 = best.replace(/^data:[^,]*,/, ''); out.mime_type = meta.mime_type; }\n}\nreturn [{ json: { raw: JSON.stringify(out), ts: String(Math.floor(Date.now() / 1000)), from: meta.from } }];"
      },
