        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const r = JSON.parse($('Corpo bruto').item.json.raw); return JSON.stringify({ number: r.to.replace('+', ''), title: 'Pedido de uso de veículo', description: r.message.body.split('\\n').slice(2).join('\\n'), footer: 'FleetMind', buttons: r.message.buttons.map(b => ({ type: 'reply', displayText: b.title, id: b.id })) }); })() }}",
        "options": {
          "timeout": 20000
        }
      },
