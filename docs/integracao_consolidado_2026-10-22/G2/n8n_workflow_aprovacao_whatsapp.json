    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Procura, no evento do Evolution Go, o toque num botao do FleetMind (approve:<token> / reject:<token>), o telefone de quem tocou e o id da mensagem.\n// Generico de proposito: o formato exato do evento varia (botao simples, native flow, LID). Ignora mensagens enviadas pelo proprio numero.\nconst cfg = $('Config entrada').first().json;\nconst evt = $('Mensagem recebida (Evolution)').first().json;\nconst body = evt.body ?? evt;\nconst text = JSON.stringify(body);\nconst info = (body.data && (body.data.Info || body.data.info)) || body.Info || {};\nconst fromMe = info.IsFromMe === true || info.isFromMe === true;\nconst m = /(approve|reject):([0-9a-f]{32,128})/.exec(text);\nif (!m || fromMe) return [];\nconst phones = [...text.matchAll(/(\\d{10,15})@s\\.whatsapp\\.net/g)].map(x => x[1]).filter(p => p !== cfg.ownNumber);\nif (!phones.length) return [];\nconst messageId = String(info.ID || info.Id || info.id || '').slice(0, 200) || null;\nreturn [{ json: { button_id: m[0], from: phones[0], message_id: messageId } }];"
      },
