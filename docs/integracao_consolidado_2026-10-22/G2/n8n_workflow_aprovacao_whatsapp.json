    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Mensagens que NAO sao toque de aprovacao: texto, audio ou botao do assistente.\n// Ignora: mensagens do proprio numero, grupos, e os toques de aprovacao (seguem pelo outro caminho).\nconst evt = $('Mensagem recebida (Evolution)').first().json;\nconst body = evt.body ?? evt;\nconst data = body.data || {};\nconst info = data.Info || data.info || {};\nconst msg = data.Message || data.message || {};\nif (info.IsFromMe === true || info.isFromMe === true) return [];\nif (info.IsGroup === true || /@g\\.us/.test(JSON.stringify(info.Chat || ''))) return [];\nif (/(approve|reject):[0-9a-f]{32,128}/.test(JSON.stringify(body))) return [];\nconst own = $('Config entrada').first().json.ownNumber;\n// quem escreveu: o JID de telefone (nao o LID); o numero do proprio FleetMind nunca e o remetente\nconst jids = JSON.stringify(info).match(/\\d{10,15}(?=@s\\.whatsapp\\.net)/g) || [];\nconst from = jids.filter(x => x !== own)[0];\nif (!from) return [];\nconst messageId = String(info.ID || info.Id || info.id || '').slice(0, 200) || null;\nconst text = msg.conversation || (msg.extendedTextMessage && msg.extendedTextMessage.text) || '';\nconst btn = (msg.buttonsResponseMessage && msg.buttonsResponseMessage.selectedButtonID) || (msg.templateButtonReplyMessage && msg.templateButtonReplyMessage.selectedID) || '';\nconst audio = msg.audioMessage;\nlet kind = 'other';\nif (btn) kind = 'button'; else if (audio) kind = 'audio'; else if (text) kind = 'text';\nreturn [{ json: { from, message_id: messageId, kind, text, button_id: btn, mime_type: audio ? (audio.mimetype || 'audio/ogg') : '', media: audio ? msg : null } }];"
      },
