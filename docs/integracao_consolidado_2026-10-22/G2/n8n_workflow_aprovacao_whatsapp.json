        "jsCode": "// Uma saida por mensagem a enviar ao usuario, na ordem (texto, botoes ou imagem).\nconst meta = $('Classificar mensagem').first().json;\nconst r = $input.first().json;\nconst body = r.replies ? r : (r.body || {});\nconst replies = Array.isArray(body.replies) ? body.replies : [];\nreturn replies.map(x => ({ json: { number: meta.from, type: x.type, text: String(x.text || ''), buttons: x.buttons || [], image: x.imageBase64 || '' } }));"
